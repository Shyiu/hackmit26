# Copy to apps/web/.env.local. The root pnpm scripts read that file too.

# MongoDB connection.
#
# Local Docker development: run `pnpm db:up`, then use:
# mongodb://127.0.0.1:27017/?directConnection=true
#
# Vercel/production: set this to your MongoDB Atlas SRV URI in the deployment
# environment. Never commit the URI or its password.
MONGODB_URI=
MONGODB_DB=memory_glasses

# Vector widths for `pnpm db:setup --search`, optional after M3. Change them and the
# vector indexes get rebuilt, and stored vectors of the old width stop matching.
OPENAI_EMBEDDING_DIMENSIONS=1536
ROOM_EMBEDDING_DIMENSIONS=512

# The one caregiver login. `pnpm db:seed` creates a caregiver with this email.
CAREGIVER_EMAIL=caregiver@example.com
CAREGIVER_PASSWORD=

# Signing secrets, 32 characters or more each, and different from each other:
#   openssl rand -base64 32
# services/perception needs the same DEVICE_TOKEN_SECRET to check socket tokens.
AUTH_SECRET=
DEVICE_TOKEN_SECRET=

# OpenAI. Model IDs live in env so we pick the current small, fast tier at build time
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_VISION_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Speech
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=
TTS_PROVIDER=elevenlabs          # or deepgram
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
DEEPGRAM_TTS_MODEL=
PICOVOICE_ACCESS_KEY=

# Web Push for danger and lost alerts. Generate a pair once with `pnpm push:keys` and
# keep the private key server-side. The subject is a mailto: or https: URL push
# services can contact about abuse. Unset, the Settings page says alerts are off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Storage for keyframes, any S3-compatible bucket
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Wiring. The phone page opens the frame socket itself, so this is the public wss:// URL
NEXT_PUBLIC_PERCEPTION_WS_URL=
# The same service over HTTP, for face enrollment from the server. Defaults to the socket's host,
# or http://127.0.0.1:8000 when that is unset too
PERCEPTION_URL=
