# Copy to .env. Empty values fall back to the defaults.

# pnpm db:up starts this one. Atlas in production.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=memory_glasses

# The same value as the web app's DEVICE_TOKEN_SECRET, at least 32 characters
DEVICE_TOKEN_SECRET=

# For the description worker. Unused until M1
OPENAI_API_KEY=

# Lease owner written on claimed description jobs. Defaults to hostname-pid
WORKER_ID=

# auto | null | yoloe. auto runs YOLOE-26 when the checkpoint below exists, else NullDetector
DETECTOR=auto
# Path to the YOLOE-26 checkpoint. See README "The YOLOE-26 detector" for pre-downloading it
YOLOE_MODEL=yoloe-26s-seg.pt
YOLOE_IMAGE_SIZE=640
# cpu, cuda:0, mps. Empty lets Ultralytics choose
YOLOE_DEVICE=
DETECTOR_CONFIDENCE=0.25
# Run the detector on every Nth live frame; the rest are dropped
FRAME_STRIDE=1
