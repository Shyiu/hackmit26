# Copy to .env. Empty values fall back to the defaults.

# pnpm db:up starts this one. Atlas in production.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=memory_glasses

# The same value as the web app's DEVICE_TOKEN_SECRET, at least 32 characters
DEVICE_TOKEN_SECRET=

# For the description worker. Unused until M1
OPENAI_API_KEY=

# Lease owner written on claimed description jobs. Defaults to hostname-pid
WORKER_ID=

# auto | null | yoloe. auto runs YOLOE-26 when the checkpoint below exists, else NullDetector
DETECTOR=auto
# Path to the YOLOE-26 checkpoint. See README "The YOLOE-26 detector" for pre-downloading it
YOLOE_MODEL=yoloe-26s-seg.pt
YOLOE_IMAGE_SIZE=640
# cpu, cuda:0, mps. Empty lets Ultralytics choose
YOLOE_DEVICE=
DETECTOR_CONFIDENCE=0.25
# Run the detector on every Nth live frame; the rest are dropped
FRAME_STRIDE=1

# Safety is mock-first and does not download model weights.
SAFETY_ENABLED=true
# Every live frame is analyzed; every Nth is stored, plus any frame behind a danger event
SAFETY_SAMPLE_EVERY_N_FRAMES=3
SAFETY_DETECTOR=mock
VLM=mock

# Real face recognition: uv sync --extra faces, then set both of these to insightface.
# The mock finds no faces in a camera frame and can't match a person.
FACE_DETECTOR=mock
FACE_EMBEDDER=mock
# Fernet key for stored embeddings. Without one the key dies with the process, and so does
# every enrollment. uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FACE_EMBEDDING_KEY=
# buffalo_l is the accurate pack, buffalo_s the small one. Changing it means enrolling again
INSIGHTFACE_MODEL=buffalo_l
# auto takes CoreML or CUDA when onnxruntime has one, else CPU
FACE_PROVIDERS=auto
FACE_DET_SIZE=640
FACE_MAX_PER_FRAME=4
# Cosine similarity a face needs to be named. Lower it if an enrolled person goes unrecognized
FACE_MATCH_THRESHOLD=0.45
FRAME_IMAGE_DIR=./data/frames
ALLOW_LOCAL_PATH_INGEST=false
INGEST_ALLOWED_DIR=
